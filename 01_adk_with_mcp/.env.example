# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: Gemini API key for ADK agents
# Get it at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: used by the remote MCP agent example
MCP_SERVER_URL=https://your-cloud-run-url.run.app/sse

# GCP settings (needed only for deployment)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
