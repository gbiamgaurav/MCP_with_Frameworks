# ─── Copy this file to .env and fill in your values ─────────────────────────
# cp .env.example .env

# GCP settings — required for deployment
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# Artifact Registry repo name (created by deploy.sh)
AR_REPO=langgraph-mcp

# Full image path — set after running deploy.sh once
# Format: REGION-docker.pkg.dev/PROJECT_ID/AR_REPO/SERVICE_NAME:latest
IMAGE=us-central1-docker.pkg.dev/your-gcp-project-id/langgraph-mcp/langgraph-mcp-server:latest

# Cloud Run service URL — set after first successful deploy
SERVICE_URL=

# Local development transport (stdio | sse | http)
MCP_TRANSPORT=stdio

# Server port (Cloud Run injects $PORT automatically)
PORT=8080
